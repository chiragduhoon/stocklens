# Set these environment variables in the shell before starting the backend.
STOCKLENS_OLLAMA_URL=http://127.0.0.1:11435
STOCKLENS_MODEL=qwen2.5:7b
STOCKLENS_LLM_TIMEOUT=90
# real (default): market data imported by `python -m backend.market_data` into data/stocklens-real.db
# demo: offline fictional dataset (data/stocklens.db), used by the tests
STOCKLENS_DATA=real
# Optional override of the database location.
# STOCKLENS_DATABASE_URL=sqlite:///data/stocklens-real.db
